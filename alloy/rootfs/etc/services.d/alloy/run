#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Alloy service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

# Add your code here

# Declare variables
declare endpoint

## Get the Prometheus endpoint from config
endpoint=$(bashio::config 'prometheus_endpoint')

## Generate config with endpoint
sed "s|\${PROMETHEUS_ENDPOINT}|${endpoint}|g" /etc/alloy/config-template.alloy > /etc/alloy/config.alloy

bashio::log.info "Starting Grafana Alloy Exporter"

## Run your program
exec /usr/bin/alloy run /etc/alloy/config.alloy --storage.path=/var/lib/alloy/data --disable-reporting